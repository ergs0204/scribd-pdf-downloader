{
  "manifest_version": 3,
  "name": "Scribd Preview to PDF",
  "version": "1.3.1",
  "description": "Reconstruct image-based Scribd preview pages and save them as a PDF.",
  "permissions": ["downloads", "tabs", "webNavigation", "scripting", "offscreen", "storage"],
  "host_permissions": [
    "https://www.scribd.com/*",
    "https://html.scribdassets.com/*",
    "http://html.scribd.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Scribd Preview to PDF",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": [
      "https://www.scribd.com/embeds/*/content*",
      "https://www.scribd.com/doc/*",
      "https://www.scribd.com/document/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
